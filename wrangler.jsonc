{
  // Cloudflare Workers config for the Sahl Technology site.
  // The Worker serves the static Astro build (dist/) and handles POST /api/quote.
  // "name" must match the Worker name in the Cloudflare dashboard.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sahltechnology",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only API routes run the Worker first; every other request is served straight from dist/.
    "run_worker_first": ["/api/*"]
  },
  // Keep variables and secrets set in the dashboard (QUOTE_*, RESEND_API_KEY, TURNSTILE_SECRET).
  "keep_vars": true,
  "observability": { "enabled": true }
}
