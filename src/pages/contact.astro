---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import QuoteForm from '../components/QuoteForm';
import { services } from '../data/services';
import FAQ from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import { SITE, socialLinks } from '../config/site';
import { breadcrumbSchema, faqSchema } from '../config/schema';
const crumbs = [{ label: 'Contact', href: '/contact/' }];
const c = SITE.contact;
const socials = socialLinks();
const faqs = [
  { q: 'How quickly will you respond?', a: 'We reply to every enquiry within one business day, usually much sooner.' },
  { q: 'Is the first consultation free?', a: 'Yes. The initial discovery call is free and without obligation.' },
  { q: 'Can you sign an NDA?', a: 'Of course. We are happy to sign a non-disclosure agreement before you share project details.' },
];
---
<Base
  title="Request a Quote"
  description="Contact Sahl Technology to discuss your software, web, mobile or IT consulting project. Free discovery call and a reply within one business day."
  keywords={['contact software company', 'get a quote', 'software development estimate']}
  schema={[breadcrumbSchema(crumbs), faqSchema(faqs), { '@type': 'ContactPage', name: 'Contact Sahl Technology', about: { '@id': `${SITE.url}/#organization` } }]}
>
  <PageHero crumbs={crumbs} eyebrow="Get in touch" title='Let’s talk about <span class="grad-text">your project</span>' lead="Share a few details and we will get back to you within one business day with next steps." />

  <section class="section-sm">
    <div class="container split" style="align-items:start">
      <div class="glass card reveal">
        <h2 style="font-size:1.6rem">Request a quote</h2>
        <!-- Multi-step form (React island) → POST /api/quote (Cloudflare Pages Function + Resend) -->
        <QuoteForm client:visible endpoint={SITE.quoteEndpoint} turnstileSiteKey={SITE.turnstileSiteKey} services={services.map((s) => s.title)} />
        <noscript><p class="form-note">The quote form needs JavaScript. Please enable it and reload the page{c.email && <>, or email us at <a href={`mailto:${c.email}`}>{c.email}</a></>}.</p></noscript>
      </div>
      <div class="grid">
        <div class="glass card reveal">
          <h2 style="font-size:1.3rem">What happens next?</h2>
          <ol class="check-list">
            <li><Icon name="check" /> We review your message and reply within 1 business day.</li>
            <li><Icon name="check" /> A free 30-minute discovery call to understand your goals.</li>
            <li><Icon name="check" /> You receive a clear proposal with scope, timeline and cost.</li>
          </ol>
        </div>
        {c.email && (
          <a class="glass card reveal" href={`mailto:${c.email}`} style="display:flex;gap:1rem;align-items:center">
            <div class="icon-tile" style="margin:0"><Icon name="mail" /></div>
            <div><h3 style="margin:0;font-size:1.05rem">Email us</h3><p style="margin:0">{c.email}</p></div>
          </a>
        )}
        {c.phone && (
          <a class="glass card reveal" href={`tel:${c.phoneHref}`} style="display:flex;gap:1rem;align-items:center">
            <div class="icon-tile" style="margin:0"><Icon name="call" /></div>
            <div><h3 style="margin:0;font-size:1.05rem">Call us</h3><p style="margin:0">{c.phone}</p></div>
          </a>
        )}
        {c.address.city && (
          <div class="glass card reveal" style="display:flex;gap:1rem;align-items:center">
            <div class="icon-tile" style="margin:0"><Icon name="pin" /></div>
            <div><h3 style="margin:0;font-size:1.05rem">Visit us</h3><p style="margin:0">{[c.address.street, c.address.city, c.address.country].filter(Boolean).join(', ')}</p></div>
          </div>
        )}
        <div class="glass card reveal" style="display:flex;gap:1rem;align-items:center">
          <div class="icon-tile" style="margin:0"><Icon name="clock" /></div>
          <div><h3 style="margin:0;font-size:1.05rem">Working hours</h3><p style="margin:0">{c.hours}</p></div>
        </div>
        {socials.length > 0 && (
          <div class="glass card reveal">
            <h3 style="font-size:1.05rem">Follow us</h3>
            <div class="socials">{socials.map((s) => <a href={s.url} target="_blank" rel="noopener me" aria-label={`Sahl Technology on ${s.key}`}><Icon name={s.key} /></a>)}</div>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal"><h2>Before you reach out</h2></div>
      <FAQ items={faqs} />
    </div>
  </section>
</Base>
