---
import { SITE } from '../config/site';
export interface SEOProps {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  keywords?: string[];
  schema?: Record<string, unknown>[];
}
const { title, description, image = SITE.defaultOgImage, noindex = false, type = 'website', keywords, schema = [] } = Astro.props as SEOProps;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;

const c = SITE.contact;
const sameAs = Object.values(SITE.social).filter(Boolean);
const org: Record<string, unknown> = {
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  legalName: SITE.legalName,
  alternateName: SITE.alternateName,
  url: `${SITE.url}/`,
  logo: { '@type': 'ImageObject', url: `${SITE.url}/icons/favicon-512.png`, width: 512, height: 512 },
  description: SITE.description,
  knowsAbout: ['Business process automation', 'Software development', 'Web development', 'Mobile app development', 'IT consulting', 'Cloud computing', 'DevOps', 'Software testing', 'Test automation', 'Playwright', 'Selenium', 'UI/UX design', 'Search engine optimization', 'Staff augmentation', 'Technical recruitment'],
};
if (sameAs.length) org.sameAs = sameAs;
if (SITE.foundingYear) org.foundingDate = SITE.foundingYear;
if (c.email) org.email = c.email;
if (c.phoneHref) org.telephone = c.phoneHref;
if (c.email || c.phoneHref)
  org.contactPoint = [{ '@type': 'ContactPoint', contactType: 'sales', ...(c.email ? { email: c.email } : {}), ...(c.phoneHref ? { telephone: c.phoneHref } : {}), availableLanguage: ['English'] }];
if (c.address.city)
  org.address = { '@type': 'PostalAddress', streetAddress: c.address.street, addressLocality: c.address.city, addressRegion: c.address.region, postalCode: c.address.postalCode, addressCountry: c.address.country };

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    org,
    { '@type': 'WebSite', '@id': `${SITE.url}/#website`, url: `${SITE.url}/`, name: SITE.name, publisher: { '@id': `${SITE.url}/#organization` }, inLanguage: SITE.lang },
    { '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: fullTitle, description, isPartOf: { '@id': `${SITE.url}/#website` }, about: { '@id': `${SITE.url}/#organization` }, inLanguage: SITE.lang, primaryImageOfPage: { '@type': 'ImageObject', url: ogImage } },
    ...schema,
  ],
};
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
{keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE.name} — ${SITE.tagline}`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" set:html={JSON.stringify(graph)} />
