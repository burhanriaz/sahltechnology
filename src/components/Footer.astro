---
import { SITE, socialLinks } from '../config/site';
import { services } from '../data/services';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
const socials = socialLinks();
const c = SITE.contact;
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a href="/" class="brand" aria-label="Sahl Technology home"><Logo tile /><span>Sahl <b>Technology</b></span></a>
        <p style="margin-top:1rem;max-width:36ch">{SITE.description}</p>
        {socials.length > 0 && (
          <div class="socials">
            {socials.map((s) => <a href={s.url} target="_blank" rel="noopener me" aria-label={`Sahl Technology on ${s.key}`}><Icon name={s.key} /></a>)}
          </div>
        )}
      </div>
      <div>
        <h2>Services</h2>
        <ul>{services.filter((s) => s.group !== 'talent').map((s) => <li><a href={`/services/${s.slug}/`}>{s.title}</a></li>)}</ul>
      </div>
      <div>
        <h2>Company</h2>
        <ul>
          <li><a href="/about/">About us</a></li>
          <li><a href="/projects/">Our work</a></li>
          <li><a href="/process/">How we work</a></li>
          <li><a href="/services/hire-dedicated-developers/">Hire dedicated developers</a></li>
          <li><a href="/services/tech-recruitment/">Tech hiring & recruitment</a></li>
          <li><a href="/services/">All services</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>
      <div>
        <h2>Get in touch</h2>
        <ul>
          {c.email && <li><a href={`mailto:${c.email}`}>{c.email}</a></li>}
          {c.phone && <li><a href={`tel:${c.phoneHref}`}>{c.phone}</a></li>}
          <li><a href="/contact/">Send us a message</a></li>
          <li><span style="color:#a9b6c9;font-size:.94rem">{c.hours}</span></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} {SITE.legalName}. All rights reserved.</span>
      <nav aria-label="Legal">
        <a href="/privacy-policy/">Privacy Policy</a>
        <a href="/terms/">Terms of Service</a>
        <a href="/privacy-policy/#cookies" data-cookie-settings>Cookie settings</a>
        <a href="/sitemap-index.xml">Sitemap</a>
      </nav>
    </div>
  </div>
</footer>
<button class="to-top" type="button" aria-label="Back to top" data-to-top><Icon name="up" /></button>
