---
/**
 * Cookie consent: a banner on first visit (Accept all / Reject / Customise)
 * and a preferences dialog that can be reopened from the footer.
 *
 * The choice is stored in localStorage under "bf-consent". Other scripts can
 * read it with window.bfConsent?.get() or listen for the "bf:consent" event,
 * and should load analytics or marketing tags only when allowed.
 */
import Icon from './Icon.astro';
---
<div class="cookie-banner glass" data-cookie-banner role="region" aria-label="Cookie consent" hidden>
  <div class="cookie-head">
    <span class="cookie-icon"><Icon name="shield" /></span>
    <h2>We value your privacy</h2>
  </div>
  <p>
    We use essential cookies to make this site work. With your consent, we would also use analytics and
    marketing cookies to understand how the site is used and improve it. Read our{" "}
    <a href="/privacy-policy/#cookies">Cookie &amp; Privacy Policy</a>.
  </p>
  <div class="cookie-actions">
    <button type="button" class="btn btn-primary" data-cookie-accept>Accept all</button>
    <button type="button" class="btn btn-ghost" data-cookie-reject>Reject</button>
    <button type="button" class="cookie-link" data-cookie-customize>Customise</button>
  </div>
</div>

<dialog class="cookie-dialog glass" data-cookie-dialog aria-labelledby="cookie-dialog-title">
  <form method="dialog">
    <div class="cookie-dialog-head">
      <h2 id="cookie-dialog-title">Cookie preferences</h2>
      <button type="submit" class="cookie-close" aria-label="Close" value="cancel"><Icon name="close" /></button>
    </div>
    <p>Choose which cookies you allow. You can change your choice at any time from the “Cookie settings” link in the footer.</p>

    <div class="cookie-option">
      <div>
        <h3>Strictly necessary</h3>
        <p>Required for the site to work, such as remembering this choice and securing the contact form. Always on.</p>
      </div>
      <label class="switch"><input type="checkbox" checked disabled aria-label="Strictly necessary cookies (always on)" /><span></span></label>
    </div>
    <div class="cookie-option">
      <div>
        <h3>Analytics</h3>
        <p>Anonymous statistics on how visitors use the site, so we can improve content and performance.</p>
      </div>
      <label class="switch"><input type="checkbox" name="analytics" aria-label="Analytics cookies" /><span></span></label>
    </div>
    <div class="cookie-option">
      <div>
        <h3>Marketing</h3>
        <p>Used to measure campaigns and show relevant ads on other platforms.</p>
      </div>
      <label class="switch"><input type="checkbox" name="marketing" aria-label="Marketing cookies" /><span></span></label>
    </div>

    <div class="cookie-actions">
      <button type="submit" class="btn btn-primary" value="save">Save preferences</button>
      <button type="submit" class="btn btn-ghost" value="all">Accept all</button>
      <button type="submit" class="cookie-link" value="none">Reject all</button>
    </div>
  </form>
</dialog>

<script>
  type Consent = { v: 1; necessary: true; analytics: boolean; marketing: boolean; ts: string };
  const KEY = 'bf-consent';

  const read = (): Consent | null => {
    try {
      const c = JSON.parse(localStorage.getItem(KEY) || 'null');
      if (!c || c.v !== 1) return null;
      // Ask again after 12 months
      if (Date.now() - Date.parse(c.ts) > 365 * 24 * 3600 * 1000) return null;
      return c;
    } catch { return null; }
  };

  const banner = document.querySelector<HTMLElement>('[data-cookie-banner]')!;
  const dialog = document.querySelector<HTMLDialogElement>('[data-cookie-dialog]')!;
  const form = dialog.querySelector('form')!;
  const box = (n: string) => form.querySelector<HTMLInputElement>(`input[name="${n}"]`)!;

  const save = (analytics: boolean, marketing: boolean) => {
    const c: Consent = { v: 1, necessary: true, analytics, marketing, ts: new Date().toISOString() };
    try { localStorage.setItem(KEY, JSON.stringify(c)); } catch { /* storage blocked */ }
    banner.hidden = true;
    document.documentElement.dataset.consent = analytics || marketing ? 'granted' : 'denied';
    window.dispatchEvent(new CustomEvent('bf:consent', { detail: c }));
  };

  const openPrefs = () => {
    const c = read();
    box('analytics').checked = c?.analytics ?? false;
    box('marketing').checked = c?.marketing ?? false;
    if (typeof dialog.showModal === 'function') dialog.showModal();
    else dialog.setAttribute('open', '');
  };

  (window as any).bfConsent = { get: read, open: openPrefs };

  if (!read()) banner.hidden = false;

  banner.querySelector('[data-cookie-accept]')!.addEventListener('click', () => save(true, true));
  banner.querySelector('[data-cookie-reject]')!.addEventListener('click', () => save(false, false));
  banner.querySelector('[data-cookie-customize]')!.addEventListener('click', openPrefs);
  document.querySelectorAll('[data-cookie-settings]').forEach((el) =>
    el.addEventListener('click', (e) => { e.preventDefault(); openPrefs(); }),
  );

  dialog.addEventListener('close', () => {
    const v = dialog.returnValue;
    if (v === 'save') save(box('analytics').checked, box('marketing').checked);
    else if (v === 'all') save(true, true);
    else if (v === 'none') save(false, false);
    dialog.returnValue = '';
  });
  // Click on the backdrop closes the dialog without saving
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close('cancel'); });
</script>

<style>
  .cookie-banner {
    position: fixed; left: 1.25rem; bottom: 1.25rem; z-index: 200;
    width: min(440px, calc(100vw - 2.5rem));
    padding: 1.4rem 1.5rem; border-radius: var(--radius);
    background: #fff;
    box-shadow: 0 24px 48px -16px rgba(6, 24, 59, .3);
    animation: cookie-in .45s cubic-bezier(.2, .8, .2, 1);
  }
  .cookie-banner[hidden] { display: none; }
  .cookie-head { display: flex; align-items: center; gap: .7rem; margin-bottom: .55rem; }
  .cookie-icon {
    display: grid; place-items: center; width: 36px; height: 36px; border-radius: 11px; flex: none;
    background: var(--teal-50); color: var(--teal);
  }
  .cookie-icon :global(svg) { width: 19px; height: 19px; }
  .cookie-banner h2, .cookie-dialog h2 { font-size: 1.1rem; margin: 0; }
  .cookie-banner p { font-size: .9rem; line-height: 1.6; color: var(--muted); margin: 0 0 1rem; }
  .cookie-banner a { color: var(--brand); }
  .cookie-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; }
  .cookie-actions .btn { padding: .6rem 1.1rem; font-size: .9rem; }
  .cookie-link {
    background: none; border: 0; color: var(--muted); font: inherit; font-size: .9rem; cursor: pointer;
    padding: .5rem .4rem; text-decoration: underline; text-underline-offset: 3px;
  }
  .cookie-link:hover { color: var(--heading); }
  @keyframes cookie-in { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }

  .cookie-dialog {
    width: min(560px, calc(100vw - 2rem)); max-height: calc(100vh - 2rem); overflow: auto;
    padding: 1.6rem 1.7rem; border-radius: var(--radius); color: var(--text);
    background: #fff;
  }
  .cookie-dialog::backdrop { background: rgba(6, 24, 59, .45); }
  .cookie-dialog-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: .5rem; }
  .cookie-close {
    display: grid; place-items: center; width: 36px; height: 36px; border-radius: 10px; cursor: pointer;
    background: #fff; border: 1px solid var(--border); color: var(--heading);
  }
  .cookie-close :global(svg) { width: 18px; height: 18px; }
  .cookie-dialog > form > p { color: var(--muted); font-size: .92rem; margin: 0 0 1.1rem; }
  .cookie-option {
    display: flex; justify-content: space-between; align-items: center; gap: 1.2rem;
    padding: 1rem 0; border-top: 1px solid var(--border);
  }
  .cookie-option h3 { font-size: .98rem; margin: 0 0 .2rem; }
  .cookie-option p { font-size: .86rem; color: var(--muted); margin: 0; line-height: 1.55; }
  .cookie-dialog .cookie-actions { margin-top: 1rem; padding-top: 1.1rem; border-top: 1px solid var(--border); }

  /* Toggle switch */
  .switch { position: relative; flex: none; width: 46px; height: 26px; cursor: pointer; }
  .switch input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: inherit; }
  .switch span {
    position: absolute; inset: 0; border-radius: 999px; transition: background .2s;
    background: var(--border-strong);
  }
  .switch span::after {
    content: ''; position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%;
    background: #fff; transition: transform .2s;
  }
  .switch input:checked + span { background: var(--teal); border-color: transparent; }
  .switch input:checked + span::after { transform: translateX(20px); }
  .switch input:disabled + span { opacity: .6; }
  .switch input:focus-visible + span { outline: 2px solid var(--brand); outline-offset: 2px; }

  @media (max-width: 520px) {
    .cookie-banner { left: .75rem; right: .75rem; bottom: .75rem; width: auto; }
    .cookie-actions .btn { flex: 1; justify-content: center; }
  }
</style>
